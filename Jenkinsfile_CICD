pipeline {
    agent any

    tools {
        maven 'Maven 3.9.16'
    }

    stages {

        stage('Compile') {
            steps {
                echo '🔨 Compilando el proyecto...'
                sh 'mvn clean compile'
            }
        }

        stage('Test') {
            steps {
                echo '🧪 Ejecutando tests...'
                sh 'mvn test'
            }
        }

        stage('SonarQube') {
            steps {
                echo '🔎 Analizando el código con SonarQube...'

                withSonarQubeEnv('SonarQube') {
                    sh '''
                        mvn sonar:sonar \
                        -Dsonar.projectKey=curso_20260921_cicd \
                        -Dsonar.host.url=http://sonarQube:9000
                    '''
                }
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline terminado correctamente'
        }

        failure {
            echo '❌ El pipeline ha fallado'
        }
    }
}
